generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  password      String
  role          String      @default("EMPLOYEE")
  department    String      @default("General")
  managerId     String?
  manager       User?       @relation("ManagerRelation", fields: [managerId], references: [id])
  subordinates  User[]      @relation("ManagerRelation")
  goalSheets    GoalSheet[]
  checkIns      CheckIn[]   @relation("ManagerCheckIns")
  auditLogs     AuditLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Cycle {
  id         String      @id @default(cuid())
  name       String
  year       Int
  startDate  DateTime
  endDate    DateTime
  status     String      @default("ACTIVE")
  goalSheets GoalSheet[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model GoalSheet {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  cycleId     String
  cycle       Cycle     @relation(fields: [cycleId], references: [id])
  status      String    @default("DRAFT")
  submittedAt DateTime?
  approvedAt  DateTime?
  returnedAt  DateTime?
  returnNote  String?
  isLocked    Boolean   @default(false)
  goals       Goal[]
  checkIns    CheckIn[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, cycleId])
}

model Goal {
  id            String        @id @default(cuid())
  goalSheetId   String
  goalSheet     GoalSheet     @relation(fields: [goalSheetId], references: [id], onDelete: Cascade)
  thrustArea    String
  title         String
  description   String        @default("")
  uom           String
  target        Float
  targetDate    DateTime?
  weightage     Float
  status        String        @default("NOT_STARTED")
  isShared      Boolean       @default(false)
  sharedFromId  String?
  sharedFrom    Goal?         @relation("SharedGoal", fields: [sharedFromId], references: [id])
  sharedCopies  Goal[]        @relation("SharedGoal")
  achievements  Achievement[]
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Achievement {
  id            String   @id @default(cuid())
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  quarter       String
  plannedTarget Float
  actualValue   Float    @default(0)
  score         Float    @default(0)
  comment       String   @default("")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([goalId, quarter])
}

model CheckIn {
  id          String    @id @default(cuid())
  goalSheetId String
  goalSheet   GoalSheet @relation(fields: [goalSheetId], references: [id])
  managerId   String
  manager     User      @relation("ManagerCheckIns", fields: [managerId], references: [id])
  quarter     String
  comment     String
  conductedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@unique([goalSheetId, quarter])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousValue String   @default("{}")
  newValue      String   @default("{}")
  timestamp     DateTime @default(now())
}
